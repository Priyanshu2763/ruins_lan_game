<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The game itself is mouse/touch driven, no camera/mic features today - not requested. -->

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Wreckveil"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!--
          This app is currently just an outer container: a splash screen (placeholder, real
          branding to follow) and a full-screen WebView pointed at the live game
          (see MainActivity.GAME_URL). No native game logic lives here — the whole game keeps
          running exactly as it does in a desktop browser, this just gives it an installable,
          app-icon-on-the-home-screen wrapper.
        -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Wreckveil.Splash"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Real bug found from a live report: login/create buttons "not working" on a real phone.
          screenOrientation used to be "userLandscape" here, forcing landscape from the very first
          frame — including the login form, which the web client (public/index.html/ui.js) was
          never designed to be viewed in: it already has its OWN orientation handling
          (#rotateOverlay, touchControls.js's screen.orientation.lock('landscape')) that
          deliberately only locks to landscape once an actual MATCH starts, leaving menus/login in
          whatever orientation the phone is naturally held in (portrait, for comfortable typing).
          Measured directly (headless Chrome at realistic short-landscape phone dimensions,
          780x360 CSS px): the "Create Account" button's bottom edge sits AT/PAST the bottom of
          that viewport (bottom=360.6 in a 360px-tall viewport) — clipped/unreachable, with "Log
          In" sitting uncomfortably tight against the same edge. "unspecified" (the normal Android
          default: free sensor rotation, respecting the user's own system rotation-lock setting)
          lets the login/dashboard render in the phone's natural portrait orientation, where the
          same layout has comfortable room (verified: fully in-viewport at a 400x850 portrait
          check) — and the web client's own existing JS still locks to landscape once real
          gameplay starts, exactly as it already does for a normal mobile browser tab.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Wreckveil" />

    </application>
</manifest>
