<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The game itself is mouse/touch driven, no camera/mic features today - not requested. -->

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Wreckveil"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!--
          This app is currently just an outer container: a splash video (baked into
          res/raw/splash.mp4) plays over a full-screen WebView pointed at the live game
          (see MainActivity.GAME_URL), which starts loading in parallel underneath it — no
          separate splash Activity/delay, see MainActivity's own comment for why. No native game
          logic lives here — the whole game keeps running exactly as it does in a desktop
          browser, this just gives it an installable, app-icon-on-the-home-screen wrapper.

          screenOrientation is "unspecified" (free sensor rotation, respecting the user's own
          system rotation-lock setting), not locked — a live report traced "login/create buttons
          not working" on a real phone to a previous "userLandscape" lock here cramming the login
          form off the bottom of a short landscape viewport (measured: the Create Account button's
          bottom edge sat past the bottom of a realistic 780x360 phone viewport). The web client
          already has its own orientation handling (#rotateOverlay, touchControls.js's
          screen.orientation.lock('landscape')) that only locks to landscape once a real match
          starts, leaving menus/login in the phone's natural portrait — exactly what unspecified
          here lets happen, matching how a normal mobile browser tab already behaves.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Wreckveil">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
