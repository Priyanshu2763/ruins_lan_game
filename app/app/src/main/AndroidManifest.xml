<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The game itself is mouse/touch driven, no camera/mic features today - not requested. -->

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Wreckveil"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!--
          This app is currently just an outer container: a splash video (baked into
          res/raw/splash.mp4) plays over a full-screen WebView pointed at the live game
          (see MainActivity.GAME_URL), which starts loading in parallel underneath it — no
          separate splash Activity/delay, see MainActivity's own comment for why. No native game
          logic lives here — the whole game keeps running exactly as it does in a desktop
          browser, this just gives it an installable, app-icon-on-the-home-screen wrapper.

          screenOrientation is "userLandscape" — this is a landscape shooter, the whole app opens
          in landscape. An earlier attempt fixed a real "login/create buttons not working" report
          (the auth form's Create Account button sat past the bottom of a short landscape phone
          viewport, unreachable) by switching this to "unspecified" instead — but that traded one
          real bug for a worse one (portrait-only, contradicting what the app is meant to be).
          Fixed properly this time at the actual source: public/index.html's `.screen` CSS now
          scrolls instead of clipping when its content is taller than the viewport
          (align-items:safe center + overflow-y:auto — see that file's own comment), so the login
          form is fully reachable in landscape without needing the Activity itself unlocked.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Wreckveil">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
