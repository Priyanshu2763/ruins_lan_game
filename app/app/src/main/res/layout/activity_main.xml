<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start sequence, in strict order (see MainActivity for the actual state machine):
       1. WebView starts loading GAME_URL immediately, in the background, for the whole sequence.
       2. splashVideo: fades in, plays once, fades out.
       3. loadingScreen (splashBanner + a BGMI-style progress bar/%): fades in, stays up until the
          web side reports real load completion (or a safety timeout), fades out.
       4. splashBackdrop fades out, revealing the (by now loaded) game underneath.
     offlineOverlay sits on top of all of it, shown/hidden independently whenever the WebView
     itself reports a load failure — can interrupt any of the above at any point. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_background" />

    <!-- Sits between the WebView and the video/loading-screen. The FrameLayout's own background
         above is useless for this — the WebView is match_parent too, so it fully covers it.
         Without this, the letterbox/pillarbox gap around the (aspect-fit) video showed whatever
         the WebView happened to be rendering underneath instead of a clean color — a live-reported
         bug ("messy" on the sides). Faded out last, once the whole splash sequence is done. -->
    <View
        android:id="@+id/splashBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_background" />

    <!-- Sized in code (MainActivity.sizeSplashVideoToAspect) to letterbox/pillarbox the full,
         un-cropped video frame within whatever space is available, centered by this gravity.
         Starts at alpha 0 — MainActivity fades it in once it starts playing. -->
    <TextureView
        android:id="@+id/splashVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:alpha="0" />

    <!-- Beat 2: the banner (res/drawable/splash_banner.jpg, used as supplied, no crop —
         fitCenter shows the whole frame) doubles as a real loading screen, not just decoration —
         a BGMI-style thin gold progress bar + percentage near the bottom, driven by real load
         progress reported from the web side (shared/... -> characters.js's reportLoadProgress ->
         window.AndroidBridge, see MainActivity's WebAppInterface). Grouped in one container so
         fading the whole loading screen in/out is a single animation, not three kept in sync by
         hand. Starts alpha 0 + GONE; MainActivity controls both. -->
    <FrameLayout
        android:id="@+id/loadingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone">

        <ImageView
            android:id="@+id/splashBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_banner" />

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="48dp"
            android:layout_marginBottom="40dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/splash_gold"
            android:progressBackgroundTint="#332E22" />

        <TextView
            android:id="@+id/loadingProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="52dp"
            android:layout_marginStart="48dp"
            android:textColor="@color/splash_gold"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium"
            android:text="@string/loading_prefix" />

    </FrameLayout>

    <!-- Topmost: shown/hidden independently of the splash sequence above, whenever the WebView
         itself fails to load (MainActivity's onReceivedError) — can interrupt the video or
         loading-screen phase at any point, or appear later if the connection drops mid-match.
         Fully opaque, so whatever's happening underneath is irrelevant while this is up. -->
    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/splash_background"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/splash_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/offline_subtitle"
            android:textColor="@color/splash_gold_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/offlineRetryBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="36dp"
            android:text="@string/offline_retry"
            android:textColor="@color/splash_background"
            android:textStyle="bold"
            android:backgroundTint="@color/splash_gold" />

    </LinearLayout>

</FrameLayout>
