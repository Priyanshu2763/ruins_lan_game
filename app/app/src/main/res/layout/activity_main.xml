<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView (game) starts loading immediately, underneath a splash video overlay played on
     top of it — see MainActivity for the "play once, then fade out" reveal logic. FrameLayout so
     the video simply sits on top, no separate splash Activity/transition needed.

     The video is a TextureView (MainActivity drives a MediaPlayer into it directly), not the
     android.widget.VideoView used in an earlier version — VideoView wraps a SurfaceView
     internally, which is a genuinely separate compositor surface that (without an explicit
     setZOrderOnTop call VideoView doesn't expose) defaults to sitting BEHIND the window's own
     content. With a WebView underneath (itself hardware-accelerated), that meant the video's
     audio played fine (a separate pipeline, unaffected) while the picture itself was invisible —
     a live-reported bug ("sound comes, no visual"). TextureView is a normal View subclass that
     composites through the regular view hierarchy, so it just works on top with no special
     handling needed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/splash_background" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Sits between the WebView and the video. The FrameLayout's own background above is
         useless for this — the WebView is match_parent too, so it fully covers it. Without this,
         the letterbox/pillarbox gap around the (aspect-fit, non-full-bleed) video showed whatever
         the WebView happened to be rendering underneath instead of a clean color — a live-reported
         bug ("messy" on the sides). Faded out together with the video in MainActivity.revealGame(). -->
    <View
        android:id="@+id/splashBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_background" />

    <!-- Sized in code (MainActivity.sizeSplashVideoToAspect) to letterbox/pillarbox the full,
         un-cropped video frame within whatever space is available, centered by this gravity.
         Starts at alpha 0 — MainActivity fades it in once the banner phase below hands off to it,
         rather than snapping straight to visible. -->
    <TextureView
        android:id="@+id/splashVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:alpha="0" />

    <!-- First splash beat: a static banner (res/drawable/splash_banner.jpg, used as supplied, no
         crop — fitCenter shows the whole frame the same way the video's own letterbox logic does)
         that fades in, holds, then fades out before the video takes over — see MainActivity's
         runBannerThenVideo(). scaleType=fitCenter is what "as is, don't crop" actually needs here;
         the video needs its own manual aspect math instead only because TextureView has no
         equivalent built-in scale mode. On top of everything (highest in this FrameLayout), shown
         first, so it's what the user actually sees at cold start. -->
    <ImageView
        android:id="@+id/splashBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/splash_banner"
        android:alpha="0" />

</FrameLayout>
